{
  "name": "vital",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "//db": "pg, @types/pg, and node-pg-migrate are REGULAR dependencies (not devDependencies) on purpose: the production migrate job (.do/app.yaml PRE_DEPLOY) builds under NODE_ENV=production, which prunes devDeps, so the migration runner and the API routes' typed pg access must survive pruning. See docs/database.md.",
  "dependencies": {
    "@clerk/backend": "^3.4.14",
    "@clerk/expo": "^3.3.1",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@types/pg": "^8.20.0",
    "compression": "^1.8.1",
    "expo": "~56.0.8",
    "expo-auth-session": "~56.0.13",
    "expo-constants": "~56.0.16",
    "expo-crypto": "~56.0.4",
    "expo-font": "~56.0.5",
    "expo-linking": "~56.0.13",
    "expo-router": "~56.2.8",
    "expo-secure-store": "~56.0.4",
    "expo-server": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "express": "^5.1.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^25.9.1",
    "@types/react": "~19.2.2",
    "eslint": "9.39.4",
    "eslint-config-expo": "56.0.4",
    "globals": "17.6.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.60.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0",
    "lint:rules-test": "node --test eslint-rules/*.test.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export -p web",
    "serve": "node server.js",
    "migrate": "node scripts/check-database-url.js && node node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:create": "node node_modules/node-pg-migrate/bin/node-pg-migrate.js create -j sql",
    "migrate:down": "node scripts/check-database-url.js && node node_modules/node-pg-migrate/bin/node-pg-migrate.js down"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  }
}
